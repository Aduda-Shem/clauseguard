# Django
SECRET_KEY=change-me-to-a-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Postgres (used by docker-compose; omit/leave blank to fall back to local sqlite)
DATABASE_URL=postgres://clauseguard:clauseguard@db:5432/clauseguard

# CORS - the frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5174

# Optional: without this key, ClauseGuard runs on rule-based analysis only,
# with deterministic template redlines/chat answers instead of
# LLM-generated ones. See docs/ARCHITECTURE.md "What's real vs simulated".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
